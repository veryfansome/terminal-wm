__pycache__/
*.pyc
.venv/
.DS_Store

# Data roots live OUTSIDE this repo and are reached by absolute path through TWM_CUPS_ROOT.
# Nothing under data/ is tracked — not even the manifests. A half-present clone (manifests
# tracked, shards gitignored) is worse than an absent one: the integrity stamps resolve and then
# the loader dies deep inside a paid run. The eval's preflight asserts the shards exist instead.
data/

# Encoder checkpoints ("eyes") are pulled from the pinned HF repo, never committed.
enc/
ckpt/

# The engine owns these. genomes.jsonl is the archive and IS tracked (it is the record); the
# private per-candidate breakdowns are deliberately not.
evolve/archive/private/
evolve/.cache/

# per-candidate scratch from the pack lane
.results/
cloud/podresults/

# Real trajectories copied into inventor jails so a mechanical question about the data is
# answered by looking rather than inferred. Regenerated from a data root by evolve/jail_sample.py,
# which is tracked; the sample itself is derived and is not.
evolve/jail_data/

# Derived lane artifacts. build_context writes .cache/ at the repo root; an encoded context
# is around a gigabyte and is rebuilt on demand.
.cache/

# No tensor or model artifact belongs in git, wherever it lands.
*.pt
*.pth
*.safetensors

# The lane records its pod id here; a committed id points at a box that may still bill.
cloud/.lane-pod
cloud/podresults-archive/
